<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" 
                name="gz::sim::systems::DiffDrive">
                <left_joint>Base_left_r_wheel</left_joint>
                <right_joint>Base_right_r_wheel</right_joint>
                <wheel_separation>0.9</wheel_separation>
                <wheel_radius>0.2</wheel_radius>
                <frame_id>odom</frame_id>
                <child_frame_id>base_footprint</child_frame_id>
                <topic>/cmd_vel</topic>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" 
                name="gz::sim::systems::JointStatePublisher">
                <joint_name>Base_left_r_wheel</joint_name>
                <joint_name>Base_right_r_wheel</joint_name>
        </plugin>
    </gazebo>

    <gazebo reference="caster_wheel_link">
        <mu1 value="0.1" />
        <mu2 value="0.1" />
    </gazebo>


</robot>