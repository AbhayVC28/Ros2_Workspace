<?xml version="1.0"?>
<robot name="my_robot">

    <material name="green">
        <color rgba="0 0.5 0 1"/>
    </material>
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>
    <material name="blue">
        <color rgba="0 0 0.7 1"/>
    </material>
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.6 0.4 0.2" />
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0" />
            <material name="green"/>
        </visual>
    </link>

    <link name="second_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.2"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0" />
            <material name="grey"/>
        </visual>
    </link>


    <link name="third_link">
        <visual>
            <geometry>
                <box size="0.1 0.05 0.1"/>
            </geometry>
            <origin xyz="0 0.025 0.05" rpy="0 0 0" />
            <material name="blue"/>
        </visual>
    </link>
    <link name="forth_link">
        <visual>
            <geometry>
                <box size="0.1 0.05 0.1"/>
            </geometry>
            <origin xyz="0 -0.025 0.05" rpy="0 0 0" />
            <material name="blue"/>
        </visual>
    </link>

    <!-- <link name="right_front_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0.025 0" rpy="1.57 0 0" />
            <material name="blue"/>
        </visual>
    </link>

    <link name="left_front_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 -0.025 0" rpy="1.57 0 0" />
            <material name="blue"/>
        </visual>
    </link> -->

    <link name="left_rear_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 -0.025 0" rpy="1.57 0 0" />
            <material name="blue"/>
        </visual>
    </link>

    <link name="right_rear_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0.025 0" rpy="1.57 0 0" />
            <material name="blue"/>
        </visual>
    </link>

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue"/>
        </visual>
    </link>

    <link name="base_footprint">
    </link>


     <joint name="base_second_joint" type="continuous">
        <parent link="base_link" />
        <child link="second_link" />
        <axis xyz="0 0 1" />
        <!-- <limit lower="1.57" upper="-1.57" velocity ="100" effort="100" /> -->
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
    
    </joint>

    <joint name="second_third_joint" type="prismatic">
        <parent link="second_link" />
        <child link="third_link" />
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0.0" upper="0.025" velocity ="100" effort="100"/>
    
    </joint>

    <joint name="second_forth_joint" type="prismatic">
        <parent link="second_link" />
        <child link="forth_link" />
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.025" upper="0" velocity ="100" effort="100"/>
    
    </joint>

    <!-- <joint name="Base_right_f_wheel" type="continuous">
        <parent link="base_link" />
        <child link="right_front_wheel" />
        <origin xyz="0.25 0.2 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="Base_left_f_wheel" type="continuous">
        <parent link="base_link" />
        <child link="left_front_wheel" />
        <origin xyz="0.25 -0.2 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint> -->

    <joint name="Base_left_r_wheel" type="continuous">
        <parent link="base_link" />
        <child link="left_rear_wheel" />
        <origin xyz="-0.25 -0.2 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="Base_right_r_wheel" type="continuous">
        <parent link="base_link" />
        <child link="right_rear_wheel" />
        <origin xyz="-0.25 0.2 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="Base_caster_wheel" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="0.2 0 -0.05" rpy="0 0 0"/>
    </joint>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>


</robot>