<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


    <xacro:property name="base_length" value="1.2"/>
    <xacro:property name="base_width" value="0.8"/>
    <xacro:property name="base_height" value="0.4"/>
    <xacro:property name="wheel_radius" value="0.2"/>
    <xacro:property name="wheel_length" value="0.1"/>
    <xacro:property name="sholder_radius" value="0.2"/>
    <xacro:property name="sholder_length" value="0.4"/>
    <xacro:property name="claw_length" value="0.2"/>
    <xacro:property name="claw_width" value="0.1"/>
    <xacro:property name="claw_height" value="0.2"/>
    <xacro:property name="caster_wheel_radius" value="0.1"/>

    

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0" />
            <material name="green"/>
        </visual>
        <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 ${base_height/2.0}" o_rpy="0 0 0" />
    </link>

    <link name="second_link">
        <visual>
            <geometry>
                <cylinder radius="${sholder_radius}" length="${sholder_length}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0" />
            <material name="grey"/>
        </visual>
    </link>


    <link name="third_link">
        <visual>
            <geometry>
                <box size="${claw_length} ${claw_width} ${claw_height}"/>
            </geometry>
            <origin xyz="0 ${claw_width/2.0} ${claw_height/2.0}" rpy="0 0 0" />
            <material name="blue"/>
        </visual>
    </link>
    <link name="forth_link">
        <visual>
            <geometry>
                <box size="${claw_length} ${claw_width} ${claw_height}"/>
            </geometry>
            <origin xyz="0 ${-claw_width/2.0} ${claw_height/2.0}" rpy="0 0 0" />
            <material name="blue"/>
        </visual>
    </link>

    <!-- <link name="right_front_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0.025 0" rpy="1.57 0 0" />
            <material name="blue"/>
        </visual>
    </link>

    <link name="left_front_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 -0.025 0" rpy="1.57 0 0" />
            <material name="blue"/>
        </visual>
    </link> -->

    <xacro:macro name="wheel" params="prefix y">
        <link name="${prefix}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 ${y*wheel_length/2.0} 0" rpy="${pi/2.0} 0 0" />
                <material name="blue"/>
            </visual>
        </link>
    </xacro:macro>

    <xacro:wheel prefix="right" y="1" />
    <xacro:wheel prefix="left"  y="-1"/>

    <!-- <link name="left_rear_wheel">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 ${-wheel_length/2.0} 0" rpy="${pi/2.0} 0 0" />
            <material name="blue"/>
        </visual>
    </link>

    <link name="right_rear_wheel">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 ${wheel_length/2.0} 0" rpy="${pi/2.0} 0 0" />
            <material name="blue"/>
        </visual>
    </link> -->

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue"/>
        </visual>
    </link>

    <link name="base_footprint">
    </link>


     <joint name="base_second_joint" type="continuous">
        <parent link="base_link" />
        <child link="second_link" />
        <axis xyz="0 0 1" />
        <!-- <limit lower="1.57" upper="-1.57" velocity ="100" effort="100" /> -->
        <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    
    </joint>

    <joint name="second_third_joint" type="prismatic">
        <parent link="second_link" />
        <child link="third_link" />
        <origin xyz="0 0 ${sholder_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0.0" upper="0.025" velocity ="100" effort="100"/>
    
    </joint>

    <joint name="second_forth_joint" type="prismatic">
        <parent link="second_link" />
        <child link="forth_link" />
        <origin xyz="0 0 ${sholder_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.025" upper="0" velocity ="100" effort="100"/>
    
    </joint>

    <!-- <joint name="Base_right_f_wheel" type="continuous">
        <parent link="base_link" />
        <child link="right_front_wheel" />
        <origin xyz="0.25 0.2 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="Base_left_f_wheel" type="continuous">
        <parent link="base_link" />
        <child link="left_front_wheel" />
        <origin xyz="0.25 -0.2 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint> -->

    <joint name="Base_left_r_wheel" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel" />
        <origin xyz="${-((base_length/2.0)-0.05)} ${-base_width/2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="Base_right_r_wheel" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel" />
        <origin xyz="${-((base_length/2.0)-0.05)} ${base_width/2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="Base_caster_wheel" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="0.2 0 ${-caster_wheel_radius}" rpy="0 0 0"/>
    </joint>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

</robot>