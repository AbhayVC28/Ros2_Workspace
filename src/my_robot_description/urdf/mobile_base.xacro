<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


    <xacro:property name="base_length" value="1.2"/>
    <xacro:property name="base_width" value="0.8"/>
    <xacro:property name="base_height" value="0.4"/>
    <xacro:property name="wheel_radius" value="0.2"/>
    <xacro:property name="wheel_length" value="0.1"/>
    <xacro:property name="caster_wheel_radius" value="0.1"/>
    <xacro:property name="arm_base_length" value="0.1"/>
    <xacro:property name="arm_base_width" value="0.1"/>
    <xacro:property name="arm_base_height" value="0.02"/>
    <xacro:property name="forearm_length" value="0.3"/>
    <xacro:property name="forearm_radius" value="0.02"/>
    <xacro:property name="hand_radius" value="0.02"/>
    <xacro:property name="hand_lenght" value="0.3"/>

    

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0" />
            <material name="green"/>
        </visual>

        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0" />
        </collision>

        <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 ${base_height/2.0}" o_rpy="0 0 0" />
    </link>


    <xacro:macro name="wheel" params="prefix y">
        <link name="${prefix}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 ${y*wheel_length/2.0} 0" rpy="${pi/2.0} 0 0" />
                <material name="blue"/>
            </visual>

            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}" />
                </geometry>
                <origin xyz="0 ${y*wheel_length/2.0} 0" rpy="0 0 0" />
            </collision>

            <xacro:cylinderical_inertia m="1" r="${wheel_radius}" l="${wheel_length}" o_xyz="0 ${y*wheel_length/2.0} 0" o_rpy="${pi/2.0} 0 0" />
        </link>
    </xacro:macro>

    <xacro:wheel prefix="right" y="1" />
    <xacro:wheel prefix="left"  y="-1"/>

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue"/>
        </visual>

        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <xacro:spherical_inertia m="0.5" r="${caster_wheel_radius}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <link name="base_footprint">
    </link>


    <link name="arm_base_link">
        <visual>
            <geometry>
                <box size="${arm_base_length} ${arm_base_width} ${arm_base_height}" />
            </geometry>
            <origin xyz="0 0 ${arm_base_height/2.0}" rpy="0 0 0" />
            <material name="orange"/>
        </visual>

        <collision>
            <geometry>
                <box size="${arm_base_length} ${arm_base_width} ${arm_base_height}" />
            </geometry>
            <origin xyz="0 0 ${arm_base_height/2.0}" rpy="0 0 0" />
        </collision>

        <xacro:box_inertia m="0.5" x="${arm_base_length}" y="${arm_base_width}" z="${arm_base_height}" o_xyz="0 0 ${arm_base_height/2.0}" o_rpy="0 0 0" />
    </link>

    <link name="forearm_link">
        <visual>
            <geometry>
                <cylinder radius="${forearm_radius}" length="${forearm_length}" />
            </geometry>
            <origin xyz="0 0 ${forearm_length/2.0}" rpy="0 0 0" />
            <material name="yellow"/>
        </visual>

        <collision>
                <geometry>
                    <cylinder radius="${forearm_radius}" length="${forearm_length}"/>
                </geometry>
                <origin xyz="0 0 ${forearm_length/2.0}" rpy="0 0 0" />
            </collision>

            <xacro:cylinderical_inertia m="0.3" r="${forearm_radius}" l="${forearm_length}" o_xyz="0 0 ${forearm_length/2.0}" o_rpy="0 0 0" />

    </link>

    <link name="hand_link">
        <visual>
            <geometry>
                <cylinder radius="${hand_radius}" length="${hand_lenght}"/>
            </geometry>
            <origin xyz="0 0 ${hand_lenght/2.0}" rpy="0 0 0"/>
        </visual>
        <material name="orange"/>

        <collision>
                <geometry>
                    <cylinder radius="${hand_radius}" length="${hand_lenght}"/>
                </geometry>
                <origin xyz="0 0 ${hand_lenght/2.0}" rpy="0 0 0"/>
            </collision>

            <xacro:cylinderical_inertia m="0.3" r="${hand_radius}" l="${hand_lenght}" o_xyz="0 0 ${hand_lenght/2.0}" o_rpy="0 0 0" />
        
    </link>


    <joint name="Base_left_r_wheel" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel" />
        <origin xyz="${-((base_length/2.0)-0.05)} ${-base_width/2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="Base_right_r_wheel" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel" />
        <origin xyz="${-((base_length/2.0)-0.05)} ${base_width/2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="Base_caster_wheel" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="0.2 0 ${-caster_wheel_radius}" rpy="0 0 0"/>
    </joint>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <joint name="base_forearm_link" type="revolute">
        <parent link="arm_base_link"/>
        <child link="forearm_link"/>
        <origin xyz="0 0 ${arm_base_height}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="${pi/2.0}" effort="100" velocity="100"/>
        <dynamics damping="0.3" friction="0.3"/>
    </joint>

    <joint name="hand_forearm_joint" type="revolute">
        <parent link="forearm_link"/>
        <child link="hand_link"/>
        <origin xyz="0 0 ${forearm_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0" upper="${pi/2.0}" effort="100" velocity="100"/>
        <dynamics damping="0.3" friction="0.3"/>
        
    </joint>

    <joint name="base_arm_joint" type="fixed">
        <parent link="base_link"/>
        <child link="arm_base_link"/>
        <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    </joint>


</robot>